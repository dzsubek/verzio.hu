---
import { cta, nav, brand } from '../content/site';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a href="#top" class="nav__brand" aria-label={`${brand.name}, vissza az oldal tetejére`}>
      <Logo />
    </a>

    <nav class="nav__links" aria-label="Fő navigáció">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__actions">
      <Button href={cta.href} size="sm" class="nav__cta">{cta.label}</Button>
      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobil-menu"
        data-menu-toggle
      >
        <span class="visually-hidden" data-menu-label>Menü megnyitása</span>
        <Icon name="list" size="1.5rem" class="nav__icon-open" />
        <Icon name="x" size="1.5rem" class="nav__icon-close" />
      </button>
    </div>
  </div>

  <div class="menu" id="mobil-menu" data-menu hidden>
    <nav aria-label="Mobil navigáció">
      <ul role="list" class="menu__list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} data-menu-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu__foot">
      <Button href={cta.href} class="menu__cta">{cta.label}</Button>
      <a class="menu__mail" href={`mailto:${brand.email}`}>{brand.email}</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (toggle && menu && label) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Menü bezárása' : 'Menü megnyitása';
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
        menu.querySelector<HTMLElement>('a')?.focus();
      } else {
        menu.classList.remove('is-open');
        menu.hidden = true;
      }
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 60rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    background: rgb(0 0 0 / 0.9);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid var(--c-line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    height: var(--nav-h);
  }

  .nav__brand {
    flex: none;
    border-radius: 6px;
  }

  .nav__links {
    display: none;
  }

  .nav__links ul {
    display: flex;
    gap: var(--sp-1);
  }

  .nav__links a {
    display: block;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-control);
    font-size: var(--fs-sm);
    color: var(--c-fg-soft);
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .nav__links a:hover {
    color: var(--c-fg);
    background: rgb(255 255 255 / 0.05);
  }

  .nav__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .nav__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-control);
    border: 1px solid var(--c-line-strong);
  }

  .nav__toggle :global(.nav__icon-close),
  :global(.menu-open) .nav__toggle :global(.nav__icon-open) {
    display: none;
  }

  :global(.menu-open) .nav__toggle :global(.nav__icon-close) {
    display: block;
  }

  :global(.nav__cta) {
    display: none !important;
  }

  @media (min-width: 30rem) {
    :global(.nav__cta) {
      display: inline-flex !important;
    }
  }

  @media (min-width: 60rem) {
    .nav__links {
      display: block;
      margin-left: var(--sp-6);
    }

    .nav__toggle {
      display: none;
    }
  }

  /* Mobile menu sheet */
  .menu {
    position: fixed;
    inset: var(--nav-h) 0 0;
    z-index: var(--z-menu);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-7) var(--gutter) var(--sp-6);
    background: var(--c-bg);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  .menu[hidden] {
    display: none;
  }

  .menu.is-open {
    opacity: 1;
  }

  .menu__list {
    display: grid;
    gap: var(--sp-2);
  }

  .menu__list a {
    display: block;
    padding-block: var(--sp-2);
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    color: var(--c-fg);
  }

  .menu__list li {
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
    transition-delay: calc(var(--i) * 50ms + 60ms);
  }

  .menu.is-open .menu__list li {
    opacity: 1;
    transform: none;
  }

  .menu__foot {
    display: grid;
    gap: var(--sp-4);
  }

  .menu__mail {
    color: var(--c-fg-muted);
    justify-self: start;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
