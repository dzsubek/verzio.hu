---
// Wordmark placeholder: brand name + mint block (echoes the reference). TODO: replace with real logo.
import { brand } from '../content/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['logo', className]}>
  <span class="logo__word">{brand.name.toLowerCase()}</span><span class="logo__block" aria-hidden="true"></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.12em;
    font-weight: 650;
    font-size: 1.375rem;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .logo__block {
    display: inline-block;
    width: 0.42em;
    height: 0.72em;
    background: var(--c-accent);
    border-radius: 2px;
    transform: translateY(0.04em);
  }
</style>
