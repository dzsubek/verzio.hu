---
import { Picture } from 'astro:assets';
import { work } from '../content/site';
import Icon from './Icon.astro';
import photo from '../assets/img/munka.jpg';

const { board } = work;
const [first, second] = board.cards;
---

<section class="work" id={work.id} aria-labelledby="munka-cim" data-work>
  <div class="container">
    <div class="feature">
      <div class="feature__copy">
        <h2 id="munka-cim" class="feature__title" data-split>
          <span class="accent">{work.title[0]}</span>{' '}{work.title[1]}
        </h2>
        <p class="feature__sub" data-reveal>{work.sub}</p>
      </div>

      <div class="feature__visual" aria-hidden="true">
        <div class="feature__photo" data-parallax="-8">
          <Picture
            src={photo}
            alt=""
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 60rem) 40vw, 92vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </div>

        <div class="board board--before" data-board-before>
          <div class="board__head">
            <span>{board.before}</span>
            <Icon name="dots" size="1.1rem" />
          </div>
          <div class="ticket ticket--ghost">
            <p class="ticket__title">{first.title}</p>
            <p class="ticket__meta">
              <span class="chip">{first.owner}</span>
            </p>
            <p class="ticket__time"><Icon name="clock" /> {first.time}</p>
          </div>
        </div>

        <div class="board board--after" data-board-after>
          <div class="board__head">
            <span>{board.after}</span>
            <Icon name="dots" size="1.1rem" />
          </div>
          <div class="ticket ticket--lift" data-ticket-move>
            <p class="ticket__title">{first.title}</p>
            <p class="ticket__meta">
              <span class="chip chip--accent"><Icon name="sparkle" /> {board.tag}</span>
              <span class="chip">{first.owner}</span>
            </p>
            <p class="ticket__time"><Icon name="clock" /> {first.time}</p>
          </div>
          <div class="ticket">
            <p class="ticket__title">{second.title}</p>
            <p class="ticket__meta">
              <span class="chip chip--accent"><Icon name="sparkle" /> {board.tag}</span>
              <span class="chip">{second.owner}</span>
            </p>
            <p class="ticket__time"><Icon name="clock" /> {second.time}</p>
          </div>
        </div>

        <div class="note" data-note>
          <span class="note__text">{board.annotation}</span>
          <svg class="note__arrow" viewBox="0 0 120 60" fill="none">
            <path
              data-draw
              d="M6 8 C 22 40, 60 54, 108 44"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"></path>
            <path
              data-draw
              d="M96 34 L 109 44 L 95 53"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .work {
    padding-block: var(--sp-9);
  }

  .feature {
    display: grid;
    gap: var(--sp-8);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .feature {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--sp-7);
    }
  }

  .feature__title {
    font-size: var(--fs-2xl);
    line-height: 1.02;
    color: var(--c-fg-soft);
    max-width: 13ch;
  }

  .feature__sub {
    margin-top: var(--sp-5);
    max-width: 40ch;
    font-size: var(--fs-md);
    color: var(--c-fg-muted);
  }

  /* Visual: photo with floating boards (reference frame 16) */
  .feature__visual {
    position: relative;
    padding-bottom: 7rem;
  }

  .feature__photo {
    width: 78%;
    margin-left: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--c-surface-2);
  }

  .feature__photo :global(img) {
    width: 100%;
    height: 112%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(0.85);
  }

  .board {
    position: absolute;
    width: min(17rem, 62%);
    padding: 0.6rem;
    border-radius: var(--r-card);
    background: rgb(28 33 44 / 0.78);
    border: 1px solid var(--c-line-strong);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    box-shadow: var(--shadow-float);
    font-size: var(--fs-xs);
  }

  @media (prefers-reduced-transparency: reduce) {
    .board {
      background: #1c212c;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  .board--before {
    left: 0;
    top: 46%;
  }

  .board--after {
    left: 34%;
    bottom: 0;
  }

  .board__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.35rem 0.5rem 0.6rem;
    color: var(--c-fg-muted);
    font-size: var(--fs-sm);
  }

  .ticket {
    display: grid;
    gap: 0.55rem;
    padding: 0.8rem;
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid var(--c-line);
  }

  .ticket + .ticket {
    margin-top: 0.5rem;
  }

  .ticket--ghost {
    opacity: 0.6;
  }

  .ticket--lift {
    background: #2a303d;
    border-color: rgb(255 255 255 / 0.14);
    box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.8);
  }

  .ticket__title {
    font-size: var(--fs-sm);
    line-height: 1.3;
    color: var(--c-fg);
  }

  .ticket__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.07);
    color: var(--c-fg-soft);
  }

  .chip--accent {
    color: var(--c-accent);
    background: var(--c-accent-soft);
  }

  .ticket__time {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-fg-muted);
  }

  .note {
    position: absolute;
    left: 2%;
    bottom: 1.5rem;
    width: 30%;
    color: var(--c-fg);
    transform: rotate(-6deg);
  }

  .note__text {
    display: block;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    line-height: 1;
  }

  .note__arrow {
    width: 100%;
    max-width: 7.5rem;
    color: var(--c-accent);
  }

  /* Phones: one photo, one board, the note. The "before" board would only add clutter. */
  @media (max-width: 40rem) {
    .feature__visual {
      padding-bottom: 12rem;
    }
    .feature__photo {
      width: 100%;
      aspect-ratio: 4 / 3;
    }
    .board--before {
      display: none;
    }
    .board--after {
      left: auto;
      right: 0;
      width: 76%;
    }
    .note {
      left: 0;
      bottom: 4.5rem;
      width: 24%;
    }
    .note__text {
      font-size: 1.25rem;
    }
  }
</style>
