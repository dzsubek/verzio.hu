---
import { contact, brand } from '../content/site';
import Icon from './Icon.astro';

const { form, errors, status, success, mail } = contact;
// External endpoint only (static site): FormSubmit AJAX by default, overridable at build time.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || contact.endpoint;
---

<section class="contact" id={contact.id} aria-labelledby="kapcsolat-cim">
  <div class="container contact__grid">
    <div class="contact__intro">
      <h2 id="kapcsolat-cim" class="contact__title" data-split>
        {contact.title[0]} <span class="accent">{contact.title[1]}</span>
      </h2>
      <p class="contact__sub" data-reveal>{contact.sub}</p>

      <div class="direct" data-reveal>
        <p class="direct__label">{contact.directLabel}</p>
        <a href={`mailto:${brand.email}`} class="direct__link">
          <Icon name="envelope" />
          {brand.email}
        </a>
        <a href={brand.phoneHref} class="direct__link">
          <Icon name="phone" />
          {brand.phone}
        </a>
      </div>
    </div>

    <form
      class="form"
      novalidate
      data-form
      data-endpoint={endpoint}
      data-errors={JSON.stringify(errors)}
      data-status={JSON.stringify({ ...status, email: brand.email, sending: form.sending })}
      data-mail={JSON.stringify(mail)}
      data-reveal
    >
      <div class="form__fields" data-fields>
      <p class="form__summary" role="alert" data-summary hidden></p>

      <div class="field">
        <label for="f-name">{form.name}</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-err" />
        <p class="field__error" id="f-name-err" data-error-for="name"></p>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="f-email">{form.email}</label>
          <input
            id="f-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            aria-describedby="f-email-err"
          />
          <p class="field__error" id="f-email-err" data-error-for="email"></p>
        </div>
        <div class="field">
          <label for="f-phone">{form.phone} <span class="field__opt">({form.optional})</span></label>
          <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" />
        </div>
      </div>

      <fieldset class="field topics">
        <legend>{form.topicLegend}</legend>
        <div class="topics__list">
          {
            form.topics.map((t, i) => (
              <label class="topic">
                <input type="checkbox" name="topics" value={t} />
                <span>{t}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="field">
        <label for="f-msg">{form.message}</label>
        <p class="field__hint" id="f-msg-hint">{form.messageHint}</p>
        <textarea
          id="f-msg"
          name="message"
          rows="5"
          required
          minlength="20"
          aria-describedby="f-msg-hint f-msg-err"></textarea>
        <p class="field__error" id="f-msg-err" data-error-for="message"></p>
      </div>

      <!-- Honeypot: hidden from people and assistive tech, bots fill it in. -->
      <div class="hp" aria-hidden="true">
        <label for="f-website">{form.honeypot}</label>
        <input id="f-website" name="_honey" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field">
        <label class="consent">
          <input type="checkbox" name="consent" required aria-describedby="f-consent-err" />
          <span>
            {form.consentBefore}<a href="/adatkezeles">{form.consentLink}</a>{form.consentAfter}
          </span>
        </label>
        <p class="field__error" id="f-consent-err" data-error-for="consent"></p>
      </div>

      <button type="submit" class="submit" data-submit>
        <span data-submit-label>{form.submit}</span>
        <Icon name="arrowRight" />
      </button>

      <p class="form__status" role="status" aria-live="polite" data-status-msg></p>
      </div>

      <div class="sent" data-success hidden>
        <span class="sent__icon" aria-hidden="true"><Icon name="check" size="1.75rem" /></span>
        <h3 class="sent__title" tabindex="-1" data-success-title>{success.title}</h3>
        <p class="sent__text">{success.text}</p>
        <button type="button" class="sent__again" data-again>{success.again}</button>
      </div>
    </form>
  </div>
</section>

<script src="../scripts/form.ts"></script>

<style>
  .contact {
    padding-block: var(--sp-9);
    background:
      radial-gradient(60% 50% at 15% 100%, rgb(46 230 166 / 0.1), transparent 70%),
      var(--c-bg);
  }

  .contact__grid {
    display: grid;
    gap: var(--sp-8);
  }

  @media (min-width: 60rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
    .contact__intro {
      position: sticky;
      top: calc(var(--nav-h) + var(--sp-6));
    }
  }

  .contact__title {
    font-size: var(--fs-2xl);
    line-height: 1.02;
  }

  .contact__sub {
    margin-top: var(--sp-5);
    max-width: 36ch;
    font-size: var(--fs-md);
    color: var(--c-fg-muted);
  }

  .direct {
    display: grid;
    gap: var(--sp-2);
    margin-top: var(--sp-7);
    justify-items: start;
  }

  .direct__label {
    color: var(--c-fg-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-1);
  }

  .direct__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--fs-lg);
    letter-spacing: var(--tracking-tight);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

  .direct__link :global(svg) {
    color: var(--c-accent);
  }

  .direct__link:hover {
    border-bottom-color: var(--c-accent);
  }

  /* Form */
  .form {
    display: grid;
    gap: var(--sp-5);
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    border-radius: var(--r-card);
    background: var(--c-surface);
    border: 1px solid var(--c-line-strong);
    box-shadow: var(--shadow-card);
  }

  .form__fields {
    display: grid;
    gap: var(--sp-5);
  }

  .form__fields[hidden],
  .sent[hidden] {
    display: none;
  }

  .sent {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: var(--sp-4);
    min-height: var(--sent-min, 20rem);
    animation: sent-in var(--dur-slow) var(--ease-out) both;
  }

  .sent__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--c-accent-soft);
    color: var(--c-accent);
    box-shadow: 0 0 0 6px rgb(46 230 166 / 0.06), 0 12px 40px -8px var(--c-accent-glow);
  }

  .sent__title {
    font-size: var(--fs-xl);
    line-height: 1.05;
    outline: none;
  }

  .sent__text {
    max-width: 40ch;
    font-size: var(--fs-md);
    color: var(--c-fg-soft);
  }

  .sent__again {
    margin-top: var(--sp-2);
    min-height: 2.75rem;
    padding-inline: var(--sp-4);
    border-radius: var(--r-control);
    border: 1px solid var(--c-line-strong);
    color: var(--c-fg);
    transition: border-color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }

  .sent__again:hover {
    border-color: var(--c-accent);
    background: var(--c-accent-soft);
  }

  @keyframes sent-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  .field {
    display: grid;
    gap: var(--sp-2);
    min-width: 0;
    border: 0;
    padding: 0;
  }

  .field-row {
    display: grid;
    gap: var(--sp-5);
  }

  @media (min-width: 40rem) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  label,
  legend {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--c-fg);
  }

  legend {
    margin-bottom: var(--sp-2);
    padding: 0;
  }

  .field__opt,
  .field__hint {
    color: var(--c-fg-muted);
    font-weight: 400;
    font-size: var(--fs-sm);
  }

  .field__hint {
    margin-top: calc(-1 * var(--sp-1));
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--r-control);
    border: 1px solid rgb(255 255 255 / 0.22);
    background: var(--c-bg);
    color: var(--c-fg);
    font-size: var(--fs-base);
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
    line-height: 1.5;
  }

  input:hover,
  textarea:hover {
    border-color: rgb(255 255 255 / 0.36);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px var(--c-accent-soft);
  }

  [aria-invalid='true'] {
    border-color: var(--c-danger) !important;
  }

  .field__error {
    min-height: 0;
    font-size: var(--fs-sm);
    color: var(--c-danger);
  }

  .field__error:empty {
    display: none;
  }

  .topics__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .topic {
    position: relative;
    font-weight: 400;
  }

  .topic input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .topic span {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.45rem 1rem;
    border-radius: var(--r-pill);
    border: 1px solid rgb(255 255 255 / 0.22);
    color: var(--c-fg-soft);
    transition: all var(--dur-fast) var(--ease-out);
  }

  .topic input:hover + span {
    border-color: rgb(255 255 255 / 0.4);
  }

  .topic input:checked + span {
    background: var(--c-accent-soft);
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .topic input:focus-visible + span {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  .consent {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
    font-weight: 400;
    color: var(--c-fg-soft);
    cursor: pointer;
  }

  .consent input {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    accent-color: var(--c-accent);
  }

  .consent a {
    color: var(--c-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--c-accent);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: 3.5rem;
    padding-inline: 1.5rem;
    border-radius: var(--r-control);
    background: var(--c-accent);
    color: var(--c-accent-on);
    font-weight: 500;
    font-size: var(--fs-base);
    transition: box-shadow var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out);
  }

  .submit:hover {
    box-shadow: 0 0 0 4px var(--c-accent-soft), 0 10px 40px -8px var(--c-accent-glow);
  }

  .submit:active {
    transform: translateY(1px);
  }

  .submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .form__summary {
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-control);
    background: rgb(255 122 122 / 0.1);
    color: var(--c-danger);
    font-size: var(--fs-sm);
  }

  .form__status {
    font-size: var(--fs-sm);
    color: var(--c-fg-soft);
  }

  .form__status:empty {
    display: none;
  }

  .form__status[data-tone='ok'] {
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-control);
    background: var(--c-accent-soft);
    color: var(--c-accent);
  }

  .form__status a {
    color: var(--c-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
