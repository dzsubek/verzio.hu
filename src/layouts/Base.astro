---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/caveat/600.css';
import '../styles/global.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistLatinExt from '@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2?url';
import { brand, meta, services } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = meta.title, description = meta.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: brand.name,
  url: brand.url,
  email: brand.email,
  telephone: brand.phone,
  description: meta.description,
  areaServed: { '@type': 'Country', name: 'Magyarország' },
  address: { '@type': 'PostalAddress', addressLocality: brand.city, addressCountry: 'HU' },
  knowsLanguage: 'hu',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Szolgáltatások',
    itemListElement: services.items.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.text },
    })),
  },
};
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistLatinExt} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Progressive enhancement flags. Content stays visible if scripts never run. -->
    <script is:inline>
      (function (d) {
        var h = d.documentElement;
        h.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          h.classList.add('motion-ok');
          // Safety net: never leave the hero hidden if the motion bundle fails.
          setTimeout(function () {
            if (!h.classList.contains('motion-ready')) h.classList.add('motion-failed');
          }, 3000);
        }
      })(document);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#tartalom">Ugrás a tartalomra</a>
    <slot />
  </body>
</html>
